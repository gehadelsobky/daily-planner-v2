generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  high
  medium
  low
}

enum HabitFrequency {
  daily
  weekdays
  custom
}

enum ExerciseIntensity {
  low
  medium
  high
}

enum WaterUnit {
  cups
  ml
}

enum CarryoverState {
  pending_review
  added_to_today
  rescheduled
  dismissed
}

enum NotificationType {
  carryover_tasks
  system_alert
}

enum NotificationStatus {
  unread
  read
  dismissed
}

enum WorkspaceType {
  personal
  team
}

enum WorkspaceStatus {
  active
  suspended
  archived
}

enum WorkspaceRole {
  owner
  admin
  member
}

enum WorkspaceMemberStatus {
  active
  invited
  removed
}

enum BillingStatus {
  free
  trialing
  active
  past_due
  canceled
}

enum WorkspaceInterestType {
  pro
  team
}

enum WorkspaceInterestStatus {
  pending
  reviewed
  contacted
  closed
}

enum WorkspaceInviteRequestStatus {
  pending
  reviewed
  approved
  closed
}

enum AccountStatus {
  active
  disabled
  locked
  pending_verification
}

enum SystemRole {
  user
  super_admin
}

enum OnboardingState {
  not_started
  profile_configured
  habits_started
  first_day_completed
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  sessionVersion      Int       @default(0)
  name                String
  phoneCountry        String?
  phoneNumber         String?
  phoneE164           String?   @unique
  avatarUrl           String?
  timezone            String    @default("UTC")
  weekStartDay        Int       @default(1)
  waterDefaultTarget  Int?
  waterDefaultUnit    WaterUnit @default(cups)
  dailyLayout         Json      @default("[]")
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  accountStatus       AccountStatus    @default(active)
  systemRole          SystemRole       @default(user)
  onboardingState     OnboardingState  @default(not_started)
  onboardingCompletedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  scoreSettings    ScoreSetting[]
  dailyEntries     DailyEntry[]
  habits           Habit[]
  xpEvents         XPEvent[]
  userBadges       UserBadge[]
  userChallenges   UserChallenge[]
  notifications    Notification[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  workspaceInterestRequests WorkspaceInterest[] @relation("WorkspaceInterestRequester")
  workspaceInviteRequests WorkspaceInviteRequest[] @relation("WorkspaceInviteRequester")
  workspaceConversionEvents WorkspaceConversionEvent[] @relation("WorkspaceConversionRequester")

  @@index([createdAt])
  @@index([accountStatus, createdAt])
  @@index([onboardingState, createdAt])
}

model Workspace {
  id          String          @id @default(uuid())
  name        String
  slug        String?         @unique
  ownerUserId String
  type        WorkspaceType   @default(personal)
  status      WorkspaceStatus @default(active)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  owner        User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members      WorkspaceMember[]
  subscription Subscription?
  featureUsage FeatureUsage[]
  scoreSettings ScoreSetting[]
  dailyEntries  DailyEntry[]
  habits        Habit[]
  xpEvents      XPEvent[]
  notifications Notification[]
  interestRequests WorkspaceInterest[]
  inviteRequests WorkspaceInviteRequest[]
  conversionEvents WorkspaceConversionEvent[]

  @@index([ownerUserId])
}

model WorkspaceMember {
  id              String                @id @default(uuid())
  workspaceId     String
  userId          String
  role            WorkspaceRole         @default(owner)
  status          WorkspaceMemberStatus @default(active)
  invitedByUserId String?
  joinedAt        DateTime              @default(now())
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Subscription {
  id                     String        @id @default(uuid())
  workspaceId            String        @unique
  planCode               String
  billingStatus          BillingStatus @default(free)
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model FeatureUsage {
  id          String   @id @default(uuid())
  workspaceId String
  featureCode String
  periodKey   String
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, featureCode, periodKey])
  @@index([workspaceId, featureCode])
}

model WorkspaceInterest {
  id                String                  @id @default(uuid())
  workspaceId       String
  requestedByUserId String
  type              WorkspaceInterestType
  status            WorkspaceInterestStatus @default(pending)
  source            String
  requestCount      Int                     @default(1)
  notes             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  lastRequestedAt   DateTime                @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("WorkspaceInterestRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, type])
  @@index([status, updatedAt])
  @@index([requestedByUserId, createdAt])
  @@index([workspaceId, createdAt])
}

model WorkspaceInviteRequest {
  id                String                       @id @default(uuid())
  workspaceId       String                       @unique
  requestedByUserId String
  status            WorkspaceInviteRequestStatus @default(pending)
  pipelineStage     String?
  source            String
  requestCount      Int                          @default(1)
  requestedSeatCount Int
  inviteEmails      Json                         @default("[]")
  message           String?
  notes             String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  lastRequestedAt   DateTime                     @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("WorkspaceInviteRequester", fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
  @@index([requestedByUserId, createdAt])
  @@index([workspaceId, createdAt])
}

model WorkspaceConversionEvent {
  id               String   @id @default(uuid())
  workspaceId      String
  userId           String
  eventType        String
  source           String
  recommendedTrack String?
  activeState      String?
  targetHref       String?
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceConversionRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([source, createdAt])
  @@index([recommendedTrack, createdAt])
}

model ScoreSetting {
  id             String   @id @default(uuid())
  userId         String
  workspaceId    String?
  effectiveFrom  DateTime
  tasksWeight    Int
  growWeight     Int
  habitsWeight   Int
  exerciseWeight Int
  gratefulWeight Int
  waterWeight    Int
  createdAt      DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([userId, effectiveFrom])
  @@index([userId, effectiveFrom])
  @@index([workspaceId, effectiveFrom])
}

model DailyEntry {
  id            String    @id @default(uuid())
  userId        String
  workspaceId   String?
  date          DateTime
  growText      String?
  notesText     String?
  tomorrowItems Json      @default("[]")
  topWinsItems  Json      @default("[]")
  quoteItems    Json      @default("[]")
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  tasks          Task[]
  exerciseLogs   ExerciseLog[]
  gratitudeItems GratitudeItem[]
  waterLog       WaterLog?

  @@unique([userId, date])
  @@index([userId, date])
  @@index([workspaceId, date])
}

model Task {
  id                 String         @id @default(uuid())
  dailyEntryId       String
  title              String
  isCompleted        Boolean        @default(false)
  priority           Priority       @default(medium)
  category           String?
  sortOrder          Int            @default(0)
  createdAt          DateTime       @default(now())
  completedAt        DateTime?
  carryoverState     CarryoverState @default(pending_review)
  carryoverUpdatedAt DateTime?
  sourceTaskId       String?

  dailyEntry   DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
  sourceTask   Task?      @relation("TaskCarryoverLink", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  derivedTasks Task[]     @relation("TaskCarryoverLink")

  @@index([dailyEntryId, sortOrder])
  @@index([dailyEntryId, isCompleted])
  @@index([sourceTaskId])
  @@index([carryoverState, isCompleted])
}

model Habit {
  id          String         @id @default(uuid())
  userId      String
  workspaceId String?
  name        String
  frequency   HabitFrequency @default(daily)
  targetValue Int?
  targetUnit  String?
  customDays  Json?
  isActive    Boolean        @default(true)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  logs      HabitLog[]

  @@index([userId, isActive])
  @@index([workspaceId, isActive])
}

model HabitLog {
  id        String   @id @default(uuid())
  habitId   String
  date      DateTime
  isDone    Boolean  @default(false)
  valueDone Int?

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([date])
}

model ExerciseLog {
  id           String             @id @default(uuid())
  dailyEntryId String
  type         String
  minutes      Int
  intensity    ExerciseIntensity?
  createdAt    DateTime           @default(now())

  dailyEntry DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@index([dailyEntryId, createdAt])
}

model GratitudeItem {
  id           String   @id @default(uuid())
  dailyEntryId String
  text         String
  createdAt    DateTime @default(now())

  dailyEntry DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)

  @@index([dailyEntryId, createdAt])
}

model WaterLog {
  id           String    @id @default(uuid())
  dailyEntryId String    @unique
  target       Int?
  consumed     Int       @default(0)
  unit         WaterUnit @default(cups)

  dailyEntry DailyEntry @relation(fields: [dailyEntryId], references: [id], onDelete: Cascade)
}

model XPEvent {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String?
  date        DateTime
  xp          Int
  reason      String
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([userId, date, reason])
  @@index([userId, date])
  @@index([workspaceId, date])
}

model Badge {
  id          String @id @default(uuid())
  code        String @unique
  name        String
  description String

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedOn DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model Challenge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  rules       Json
  startDate   DateTime
  endDate     DateTime

  userChallenges UserChallenge[]
}

model UserChallenge {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  joinedOn    DateTime
  progress    Json

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model Notification {
  id          String             @id @default(uuid())
  userId      String
  workspaceId String?
  type        NotificationType
  title       String
  body        String
  payload     Json?
  status      NotificationStatus @default(unread)
  dedupeKey   String?            @unique
  createdAt   DateTime           @default(now())
  readAt      DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
  @@index([workspaceId, status, createdAt])
  @@index([workspaceId, createdAt])
}
